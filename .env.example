# Copy this file to ".env" and fill in real values.
# ".env" is gitignored on purpose — never commit real credentials.

# Base URL of the site under test (UI tests)
BASE_URL=https://automationexercise.com

# Base URL of the API under test
API_BASE_URL=https://reqres.in/api

# reqres.in now requires a free API key on every request (their 2025 relaunch).
# Get one in under a minute at https://reqres.in/signup and paste it here.
REQRES_API_KEY=your_reqres_api_key_here

# Example login credentials for a REGISTERED TEST ACCOUNT you create yourself
# on the demo site. Never use real personal credentials in a test suite.
TEST_USER_EMAIL=your_test_email@example.com
TEST_USER_PASSWORD=YourTestPassword123
